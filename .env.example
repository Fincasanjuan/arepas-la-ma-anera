# Example only. Real secrets belong in Render's Environment settings.
AREPAS_HOST=127.0.0.1
AREPAS_PORT=8787
AREPAS_DATA_DIR=data
AREPAS_ADMIN_NAME=Dujardy
# Set a NEW private password of at least 12 characters, outside Git.
# AREPAS_ADMIN_PASSWORD=
# Render provides PORT and RENDER_EXTERNAL_URL automatically.
# If using a custom domain, set its exact HTTPS origin:
# AREPAS_PUBLIC_ORIGIN=https://your-domain.example
# Optional Gemini connection, configured only in the server environment:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
